# --- Base de données (utilisée par le service "db" du docker-compose) ---
POSTGRES_USER=genetics
POSTGRES_PASSWORD=genetics
POSTGRES_DB=genetics_incidents

# URL de connexion utilisée par l'API.
# En Docker, l'hôte est le nom du service : "db".
# En local (sans Docker), remplacer "db" par "localhost".
POSTGRES_URL=postgresql://genetics:genetics@db:5432/genetics_incidents

# --- Sécurité JWT ---
SECRET_KEY=change-me-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGIN=*

# --- Comptes administrateurs (tableau de bord), séparés par des virgules ---
ADMIN_EMAILS=support@groupegenetics.com,mohamed.thialaw@groupegenetics.com,diallo30amadoukorka@gmail.com

# --- E-mails (SMTP Hostinger) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# ssl (port 465) | starttls (port 587)
SMTP_SECURITY=ssl
SMTP_USER=support@groupegenetics.com
SMTP_PASSWORD=mot-de-passe-de-la-boite
# Expéditeur affiché : la boîte SMTP_USER ou un de ses alias
MAIL_FROM=support@groupegenetics.com
MAIL_FROM_NAME=Groupe Genetics Support
# Destinataires internes (séparés par des virgules)
INCIDENT_ALERT_RECIPIENTS=support@groupegenetics.com
NEW_ACCOUNT_RECIPIENTS=support@groupegenetics.com
# Liens insérés dans les e-mails (connexion client, validation des comptes par l'admin)
SITE_LOGIN_URL=http://localhost:3001/support/login
ADMIN_ACCOUNTS_URL=http://localhost:3000/accounts
CONTACT_RECIPIENTS=contact@groupegenetics.com,admin@groupegenetics.com

# --- Ports exposés sur la machine hôte ---
API_PORT=8000
DB_PORT=5432
