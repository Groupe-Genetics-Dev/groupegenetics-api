# --- Base de données (utilisée par le service "db" du docker-compose) ---
POSTGRES_USER=genetics
POSTGRES_PASSWORD=genetics
POSTGRES_DB=genetics_incidents

# URL de connexion utilisée par l'API.
# En Docker, l'hôte est le nom du service : "db".
# En local (sans Docker), remplacer "db" par "localhost".
POSTGRES_URL=postgresql://genetics:genetics@db:5432/genetics_incidents

# --- Sécurité JWT ---
SECRET_KEY=change-me-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGIN=*

# --- Emails (Brevo / Sendinblue) ---
SENDINBLUE_API_KEY=your-brevo-api-key

# --- Ports exposés sur la machine hôte ---
API_PORT=8000
DB_PORT=5432
